# RCR's generated messages use namespace packages and a sitecustomize hook;
# aspect_rules_py, rather than rules_python, supplies that import environment.
load("@aspect_rules_py//py:defs.bzl", "py_binary")

py_binary(
    name = "python_observer",
    srcs = ["observer.py"],
    main = "observer.py",
    visibility = [
        "//examples/cli:__pkg__",
        "//tests/integration:__pkg__",
    ],
    deps = [
        "//interfaces/demo_interfaces:py",
        "@rclpy",
    ],
)
