load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_files(
    name = "documentation",
    srcs = ["README.md", "runtime.json"],
    attributes = pkg_attributes(mode = "0644"),
)

pkg_files(
    name = "scripts",
    srcs = ["run_demo.py", "verify_runtime.py"],
    attributes = pkg_attributes(mode = "0755"),
)

# Use target providers, not a glob/copy of bazel-bin. rules_pkg materializes
# declared runfiles (including root symlinks and repository mapping) beside
# each binary, preserving its package-relative path and runtime layout.
pkg_tar(
    name = "demo_archive",
    srcs = [
        ":documentation",
        ":scripts",
        "//apps/client:client",
        "//apps/observer:observer",
        "//apps/producer:producer",
    ],
    out = "ros2-bazel-demo-linux-x86_64.tar.gz",
    extension = "tar.gz",
    include_runfiles = True,
    strip_prefix = "/",
    package_dir = "ros2-bazel-demo",
    mode = "0644",
    allow_duplicates_with_different_content = False,
    stamp = 0,
)
