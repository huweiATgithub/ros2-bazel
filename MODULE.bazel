module(name = "ros2_bazel_demo")
bazel_dep(name = "ros_core", version = "lyrical.2026-06-08.rcr.2")
bazel_dep(name = "rclcpp", version = "0.0.0")
bazel_dep(name = "builtin_interfaces", version = "0.0.0")
bazel_dep(name = "rosidl_default_generators", version = "0.0.0")
bazel_dep(name = "rclpy", version = "0.0.0")
bazel_dep(name = "aspect_rules_py", version = "1.11.7")
bazel_dep(name = "std_srvs", version = "0.0.0")
bazel_dep(name = "rosdistro", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "llvm", version = "0.8.11")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "protobuf", version = "35.1")
register_toolchains("@llvm//toolchain:all")
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(is_default = True, python_version = "3.12")
bazel_dep(name = "rules_rust", version = "0.71.3")
bazel_dep(name = "launch", version = "0.0.0")
bazel_dep(name = "launch_testing", version = "0.0.0")
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021", versions = ["1.93.0"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
